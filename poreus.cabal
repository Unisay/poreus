cabal-version: 3.0
name:          poreus
version:       0.3.1.0
synopsis:      MCP server for agent-to-agent message transport
description:
  poreus ferries structured messages between AI agent sessions on one
  host via a shared SQLite store. It is exposed as an MCP server: the
  agent's host connects the server per session, operations are typed
  tool calls with schemas, and delivery is an ambient property of a
  connected session. See docs/design/protocol.md for the contract and
  docs/adr/ for the rationale.

license:       BSD-3-Clause
author:        Yuriy Lazaryev
maintainer:    yuriy.lazaryev@iohk.io
build-type:    Simple
category:      Development

common lang
  default-language:   Haskell2010
  default-extensions:
    BangPatterns
    BlockArguments
    DeriveGeneric
    DerivingStrategies
    GeneralizedNewtypeDeriving
    LambdaCase
    NamedFieldPuns
    NumericUnderscores
    OverloadedStrings
    RecordWildCards
    ScopedTypeVariables
    TupleSections

  ghc-options:
    -Wall -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wredundant-constraints

library
  import:          lang
  hs-source-dirs:  src
  exposed-modules:
    Poreus
    Poreus.Admin
    Poreus.Catalog
    Poreus.Config
    Poreus.DB
    Poreus.Deliver
    Poreus.Effects.Env
    Poreus.Effects.FileSystem
    Poreus.Effects.Process
    Poreus.Effects.Random
    Poreus.Effects.SystemInfo
    Poreus.Effects.Time
    Poreus.Hook
    Poreus.Identity
    Poreus.JSON
    Poreus.Mcp.Channel
    Poreus.Mcp.Errors
    Poreus.Mcp.Framing
    Poreus.Mcp.JsonRpc
    Poreus.Mcp.Protocol
    Poreus.Mcp.Tools
    Poreus.Name
    Poreus.Post
    Poreus.Profile
    Poreus.Query
    Poreus.Repo
    Poreus.Retention
    Poreus.Schema
    Poreus.Server
    Poreus.Session
    Poreus.Time
    Poreus.Types

  other-modules:   Paths_poreus
  autogen-modules: Paths_poreus
  build-depends:
    , aeson          ^>=2.2
    , aeson-pretty   ^>=0.8
    , base           ^>=4.18
    , bytestring
    , containers
    , directory
    , filepath
    , mtl            ^>=2.3
    , process
    , random         ^>=1.2
    , sqlite-simple  ^>=0.4
    , text
    , time
    , transformers
    , unix           ^>=2.8

executable poreus
  import:         lang
  hs-source-dirs: app
  main-is:        Main.hs
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , base    ^>=4.18
    , poreus

test-suite poreus-test
  import:             lang
  type:               exitcode-stdio-1.0
  hs-source-dirs:     test
  main-is:            Spec.hs
  ghc-options:        -threaded -rtsopts -with-rtsopts=-N
  build-tool-depends: hspec-discover:hspec-discover
  other-modules:
    Poreus.CatalogSpec
    Poreus.ConfigSpec
    Poreus.DeliverSpec
    Poreus.HookSpec
    Poreus.IdentitySpec
    Poreus.Mcp.ProtocolSpec
    Poreus.NameSpec
    Poreus.PostSpec
    Poreus.ProfileSpec
    Poreus.QuerySpec
    Poreus.RepoSpec
    Poreus.RetentionSpec
    Poreus.SessionSpec
    Poreus.TestM
    Poreus.TimeSpec
    Poreus.TypesSpec

  build-depends:
    , aeson
    , base
    , bytestring
    , containers
    , directory
    , filepath
    , hspec          ^>=2.11
    , mtl
    , poreus
    , sqlite-simple
    , temporary      ^>=1.3
    , text
    , time
    , transformers
    , unix
